{
  "name": "mint",
  "description": "薄荷的花语是：永不消逝的爱",
  "version": "7.8.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "tsx scripts/prebuild.ts && next dev",
    "build": "tsx scripts/prebuild.ts && next build && tsx scripts/postbuild.ts",
    "preview": "serve out",
    "deploy": "bash scripts/deploy/local.sh all",
    "deploy:ftp": "bash scripts/deploy/local.sh ftp",
    "deploy:cos": "bash scripts/deploy/local.sh cos",
    "deploy:dokploy": "bash scripts/deploy/local.sh dokploy",
    "postinstall": "[ -n \"$CI\" ] || lefthook install",
    "lint": "biome check --write --no-errors-on-unmatched --diagnostic-level=error ."
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@del-wang/config": "^1.8.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lefthook": "^2.2.2",
    "next-file-loader": "^2.0.0",
    "rehype-prism-plus": "^2.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
